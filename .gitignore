# Environment files
.env
.env.local
.env.*.local

# Portable MinGit used by setup and commands/update-platform.ps1 when Git for Windows is not installed
/.tools/

# Runtime data directory (stacks/builds/client), created at the repo root.
# Leading slash anchors it to the repo root so it never matches source folders such as
# backend/AzerothPlatform.Infrastructure/Data/ or frontend-armory/src/armory/data/ (a bare
# "data/" is matched case-insensitively on macOS, silently dropping tracked source files).
/data/

# Planning and analysis documents
/plans/*

# IDE
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# .NET build artifacts
**/bin/
**/obj/
**/publish/
**/TestResults/
*.user
*.suo

# Node build artifacts. The per-project ignore files cover the projects that exist today; these
# anchor the same rules for any project added later.
**/node_modules/
**/dist/

# Logs and local databases
*.log
*.db
*.sqlite
*.sqlite3
