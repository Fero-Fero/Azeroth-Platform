{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"strict": true,
		"sourceMap": true,
		"outDir": "build",
		"rootDir": "src"
	},
	"exclude": ["node_modules"],
	"include": ["src/**/*.ts"]
}
