<h1 class="title is-size-1">Verify your email</h1>

<div class="armory-panel auth-panel">
	<div class="panel-body">
		{{#if authError}}
		<div class="auth-error" role="alert">{{authError}}</div>
		{{/if}}
		{{#if authMessage}}
		<div class="auth-message" role="status">{{authMessage}}</div>
		{{/if}}
		<p class="auth-copy">
			We sent a verification link{{#if email}} to <strong>{{email}}</strong>{{/if}}.
			Open it to continue creating your account.
		</p>
		<form class="auth-form" action="{{websiteRoot}}/verify-email-pending/resend" method="post">
			<input type="hidden" name="_csrf" value="{{csrfToken}}">
			{{#unless email}}
			<label class="auth-label" for="email">Email</label>
			<input class="auth-input" id="email" name="email" type="email" maxlength="255" required>
			{{else}}
			<input type="hidden" name="email" value="{{email}}">
			{{/unless}}
			<button class="btn-download auth-submit" type="submit">Resend verification email</button>
		</form>
		<form class="auth-inline-form" action="{{websiteRoot}}/logout" method="post">
			<input type="hidden" name="_csrf" value="{{csrfToken}}">
			<button class="auth-link-button" type="submit">Log out</button>
		</form>
	</div>
</div>
