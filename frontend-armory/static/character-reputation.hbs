<div class="reputation-table" id="rep-wotlk" style="margin-bottom: 20px;{{#unless data.wotlk.length}}display:none;{{/unless}}">
    <h2 class="is-size-4">Wrath of the Lich King</h2>
    <table class="table is-striped is-hoverable is-fullwidth">
        <tbody>
            {{#each data.wotlk}}
                <tr>
                    <!-- Faction ID: {{this.id}} -->
