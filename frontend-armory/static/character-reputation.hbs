<link rel="stylesheet" type="text/css" href="{{websiteRoot}}/css/character-reputation.css">
{{> icons }}

{{> character-header }}

<div class="rep-search-bar">
    <input type="text" id="rep-search" placeholder="Search reputations..." autocomplete="off">
</div>

<div id="rep-no-results" class="rep-no-results" style="display: none;">No reputations match your search.</div>

<div class="reputation-table" style="margin-bottom: 20px;{{#unless data.classic.length}}display:none;{{/unless}}">
    <h2 class="is-size-4">Classic Reputations</h2>
    <table class="table is-striped is-hoverable is-fullwidth">
        <tbody>
            {{#each data.classic}}
                <tr>
                    <!-- Faction ID: {{this.id}} -->
                    <td>
                        <div class="reputation-row">
                            <span class="faction-name">{{this.name}}</span>
                            <div class="progress-section">
                                <div class="progress-bar-container">
                                    <div class="progress-bar {{this.standing}}" style="width: {{multiply (divide this.valueInGrade this.max) 100}}%;"></div>
                                    <span class="standing-text">{{this.standing}}</span>
                                    <span class="value-text">{{this.valueInGrade}} / {{this.max}}</span>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            {{/each}}
        </tbody>
    </table>
</div>

<div class="reputation-table" style="margin-bottom: 20px;{{#unless data.tbc.length}}display:none;{{/unless}}">
    <h2 class="is-size-4">The Burning Crusade</h2>
