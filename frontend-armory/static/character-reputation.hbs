    </table>
</div>

<script type="application/javascript">
    $(window).on("load", () => {
        const $search = $("#rep-search");
        const $noResults = $("#rep-no-results");

        $search.on("input", function () {
            const query = $(this).val().trim().toLowerCase();
            let totalVisible = 0;

            $(".reputation-table").each(function () {
                const $table = $(this);
                let sectionVisible = 0;

                $table.find("tbody tr").each(function () {
                    const name = $(this).find(".faction-name").text().toLowerCase();
                    const match = query === "" || name.indexOf(query) !== -1;
                    $(this).toggle(match);
                    if (match) {
                        sectionVisible++;
                    }
                });

                // Hide section headers that have no matching factions
                $table.toggle(sectionVisible > 0);
                totalVisible += sectionVisible;
            });

            $noResults.toggle(totalVisible === 0 && query !== "");
        });
    });
</script>
