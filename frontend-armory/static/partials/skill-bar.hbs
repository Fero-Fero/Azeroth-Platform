<div class="skill-bar" title="{{skill}} &mdash; {{value}}/{{max}}">
    <div class="skill-bar-fill" style="width: {{multiply (divide value max) 100}}%;"></div>
    <span class="skill-bar-name">{{skill}}</span>
    <span class="skill-bar-value">{{value}}<span class="skill-bar-max">/{{max}}</span></span>
</div>
