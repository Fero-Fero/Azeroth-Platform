# frontend-armory container environment (reference)
#
# When running through Azeroth Platform, the manager injects these variables into each stack's
# generated docker-compose override. Tune display/behaviour keys from the stack UI
# (Overview → Environment Variables → frontend-armory), not from the platform root .env.
#
# For standalone armory development outside the platform, copy this file to .env and adjust values:
#   cp .env.example .env
#
# Database credentials, realm wiring, session secrets, and platform bridge URLs are managed
# automatically by the platform and cannot be overridden from the stack UI.

# --- Display & behaviour (tunable per stack) ---

# Site title shown in the armory header. Blank uses the realm name.
ACORE_ARMORY_WEBSITE_NAME="Azeroth Armory"

# Hide GM characters from listings and search.
ACORE_ARMORY_HIDE_GAME_MASTERS=0

# Enable transmogrification data in the armory (requires the transmog module).
ACORE_ARMORY_TRANSMOG_MODULE=0

# Load DBC data for richer item/spell tooltips.
ACORE_ARMORY_LOAD_DBCS=1

# Fetch icons/models from the ZAM CDN instead of local assets.
ACORE_ARMORY_USE_ZAM_CDN=0

# Show the live Azeroth world map with online player positions.
ACORE_ARMORY_WORLD_MAP_MODULE=1

# Allow players to create game accounts from the armory.
ACORE_ARMORY_ACCOUNTS__ALLOW_REGISTRATION=1

# Account password length limits.
ACORE_ARMORY_ACCOUNTS__MIN_PASSWORD_LENGTH=8
ACORE_ARMORY_ACCOUNTS__MAX_PASSWORD_LENGTH=16

# How long a player login session stays valid, in hours.
ACORE_ARMORY_ACCOUNTS__SESSION_HOURS=24

# Database query timeout in milliseconds.
ACORE_ARMORY_DB_QUERY_TIMEOUT=10000

# --- Auto-managed by the platform (do not set in the root platform .env) ---

# Public URL of this stack's armory (derived from realmlist host + armory port).
# ACORE_ARMORY_WEBSITE_URL="http://192.168.1.50:48733"

# Realm and database wiring (injected from the stack's MySQL container).
# ACORE_ARMORY_REALMS__0__NAME="AzerothCore"
# ACORE_ARMORY_REALMS__0__REALM_ID=1
# ACORE_ARMORY_REALMS__0__AUTH_DATABASE="acore_auth"
# ACORE_ARMORY_REALMS__0__CHARACTERS_DATABASE__HOST="host.docker.internal"
# ACORE_ARMORY_REALMS__0__CHARACTERS_DATABASE__PORT=3306
# ACORE_ARMORY_REALMS__0__CHARACTERS_DATABASE__USER="root"
# ACORE_ARMORY_REALMS__0__CHARACTERS_DATABASE__PASSWORD=""
# ACORE_ARMORY_REALMS__0__CHARACTERS_DATABASE__DATABASE="acore_characters"
# ACORE_ARMORY_WORLD_DATABASE__HOST="host.docker.internal"
# ACORE_ARMORY_WORLD_DATABASE__PORT=3306
# ACORE_ARMORY_WORLD_DATABASE__USER="root"
# ACORE_ARMORY_WORLD_DATABASE__PASSWORD=""
# ACORE_ARMORY_WORLD_DATABASE__DATABASE="acore_world"

# Platform bridge (news feed + launcher download on /connect).
# PLATFORM_API_URL="http://host.docker.internal:8080"
# PLATFORM_PUBLIC_URL="http://192.168.1.50:48733"
# PLATFORM_STACK_ID=""
# CLIENT_PORTAL_URL="http://192.168.1.50:8081"
