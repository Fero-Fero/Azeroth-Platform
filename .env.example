# Environment configuration for Azeroth Platform Docker Compose
# Copy this file to .env and adjust the values for your system

# NOTE: The manager stores all of its state (stacks, builds, database, uploaded client base) in a
# Docker-managed named volume (azeroth-platform-data), and pushes per-stack artifacts into per-stack
# named volumes on the same daemon. There is no host `data/` directory and no HOST_DATA_PATH to set.

# LAN IP of the machine running the platform. Used as the default "realmlist host" for LOCAL stacks
# (the address written into players' realmlist.wtf and stored in acore_auth.realmlist), so game
# clients on OTHER machines on your network can connect without any per-stack configuration.
#
# Why this is required: on Docker Desktop the manager runs inside a VM/container and physically
# cannot see the host's LAN IP, so it must be provided here. Leave blank to serve 127.0.0.1
# (only the same machine can connect).
#
# Detect it (run from project root):
#   macOS:  echo "HOST_LAN_IP=$(ipconfig getifaddr en0)" >> .env
#   Linux:  echo "HOST_LAN_IP=$(hostname -I | awk '{print $1}')" >> .env
HOST_LAN_IP=

# Admin panel password. CHANGE THIS to a strong, unique value before deploying.
# If left blank/unset, the platform generates a random password at startup and writes it to
# a restricted file (see logs for the location) instead of using a guessable default.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Reverse proxy / TLS (Caddy). All external traffic is served through Caddy on ports 80/443.
#   SITE_ADDRESS - the public domain to serve (e.g. play.myrealm.example). Leave blank to serve on
#                  https://localhost with a self-signed internal certificate (browser warning expected).
#   TLS_EMAIL    - contact email for Let's Encrypt certificates (only used when SITE_ADDRESS is a real
#                  public domain that resolves to this host and ports 80/443 are reachable).
SITE_ADDRESS=
TLS_EMAIL=

# Host interface that LOCAL stack ports publish on. Both default to loopback (127.0.0.1) so a fresh
# deployment is not reachable from the internet. Game protocol ports (auth 3724, world 8085) are
# always published on all interfaces so remote clients can connect.
#   STACK_PUBLISH_BIND   - armory website + client file server (player-facing HTTP). Set to your LAN/
#                          public IP or 0.0.0.0 only after fronting with the reverse proxy / firewall.
#   STACK_DATAPLANE_BIND - MySQL + SOAP (management only; keep private). On a Linux host running this
#                          manager in a container, set to the docker bridge gateway (e.g. 172.17.0.1)
#                          so the manager can still reach it while it stays off the public internet.
STACK_PUBLISH_BIND=127.0.0.1
STACK_DATAPLANE_BIND=127.0.0.1

# Azeroth Platform bridge (injected by the platform when run per-stack). Used to fetch this stack's
# launcher news and to proxy the launcher download on the /connect page.
PLATFORM_API_URL="http://host.docker.internal:8080"
PLATFORM_STACK_ID=""

ACORE_ARMORY_WEBSITE_URL="https://mywebsite.com"
ACORE_ARMORY_WEBSITE_NAME="Azeroth Armory"
ACORE_ARMORY_WEBSITE_ROOT=""
ACORE_ARMORY_IFRAME_MODE__ENABLED=0
ACORE_ARMORY_IFRAME_MODE__URL="https://mywebsite.com/armory"
ACORE_ARMORY_LOAD_DBCS=1
ACORE_ARMORY_HIDE_GAME_MASTERS=0
ACORE_ARMORY_TRANSMOG_MODULE=0
ACORE_ARMORY_USE_ZAM_CDN=0
ACORE_ARMORY_REALMS__0__NAME="AzerothCore"
ACORE_ARMORY_REALMS__0__REALM_ID=1
ACORE_ARMORY_REALMS__0__AUTH_DATABASE="acore_auth"
ACORE_ARMORY_REALMS__0__CHARACTERS_DATABASE__HOST="localhost"
ACORE_ARMORY_REALMS__0__CHARACTERS_DATABASE__PORT=3306
ACORE_ARMORY_REALMS__0__CHARACTERS_DATABASE__USER="acore"
ACORE_ARMORY_REALMS__0__CHARACTERS_DATABASE__PASSWORD="acore"
ACORE_ARMORY_REALMS__0__CHARACTERS_DATABASE__DATABASE="acore_characters"
ACORE_ARMORY_WORLD_DATABASE__HOST="localhost"
ACORE_ARMORY_WORLD_DATABASE__PORT=3306
ACORE_ARMORY_WORLD_DATABASE__USER="acore"
ACORE_ARMORY_WORLD_DATABASE__PASSWORD="acore"
ACORE_ARMORY_WORLD_DATABASE__DATABASE="acore_world"
ACORE_ARMORY_DB_QUERY_TIMEOUT=10000
