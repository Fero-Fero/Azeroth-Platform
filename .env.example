# Environment configuration for Azeroth Platform Docker Compose
# Copy this file to .env and adjust the values for your system
#
#   cp .env.example .env
#
# Per-stack armory settings (ACORE_ARMORY_*) are NOT configured here — see
# frontend-armory/.env.example and the stack UI (Environment Variables tab).

# =============================================================================
# Platform manager (docker-compose.yml)
# =============================================================================

# NOTE: The manager stores all of its state (stacks, builds, database, uploaded client base) in a
# Docker-managed named volume (azeroth-platform-data), and pushes per-stack artifacts into per-stack
# named volumes on the same daemon. There is no host `data/` directory to create.
#
# Individual Progression stores its reference repository on each stack (not beside the platform repo):
#   {BuildsPath}/{stackId}/azeroth-platform-progression/   ← git clone on first sync, git pull after
#   {BuildsPath}/{stackId}/migrations/                     ← patch folders
# Sync and validation use that absolute stack path only — nothing is cloned onto the host outside
# the stack data directory, and no MIGRATIONS_PROGRESSION_REPO_PATH / bind-mount is required.

# LAN IP of the machine running the platform. Used as the default "realmlist host" for LOCAL stacks
# (the address written into players' realmlist.wtf and stored in acore_auth.realmlist), so game
# clients on OTHER machines on your network can connect without any per-stack configuration.
#
# Why this is required: on Docker Desktop the manager runs inside a VM/container and physically
# cannot see the host's LAN IP, so it must be provided here. Leave blank to serve 127.0.0.1
# (only the same machine can connect).
#
# Detect it (run from project root):
#   macOS:  echo "HOST_LAN_IP=$(ipconfig getifaddr en0)" >> .env
#   Linux:  echo "HOST_LAN_IP=$(hostname -I | awk '{print $1}')" >> .env
HOST_LAN_IP=

# Host interface the manager REST API is published on (port 8080).
#   0.0.0.0  — reachable from other machines on the LAN at http://<HOST_LAN_IP>:8080 (default when
#              unset in .env; used by the desktop launcher for profiles, self-update, and client config).
#   127.0.0.1 — localhost only; use this when routing admin traffic through the Caddy reverse proxy
#              (https://localhost or a public domain) and you do not want :8080 exposed on the LAN.
MANAGER_BIND=0.0.0.0

# Admin panel password. CHANGE THIS to a strong, unique value before deploying.
# If left blank/unset, the platform generates a random password at startup and writes it to
# a restricted file (see logs for the location) instead of using a guessable default.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Reverse proxy / TLS (Caddy). All external traffic is served through Caddy on ports 80/443.
#   SITE_ADDRESS - the public domain to serve (e.g. play.myrealm.example). Leave blank to serve on
#                  https://localhost with a self-signed internal certificate (browser warning expected).
#   TLS_EMAIL    - contact email for Let's Encrypt certificates (only used when SITE_ADDRESS is a real
#                  public domain that resolves to this host and ports 80/443 are reachable).
SITE_ADDRESS=
TLS_EMAIL=

# Host interface that LOCAL stack ports publish on. Compose defaults when unset:
#   STACK_PUBLISH_BIND   → 0.0.0.0  (player-facing HTTP: armory + client file server)
#   STACK_DATAPLANE_BIND → 127.0.0.1 (MySQL + SOAP — management only; keep private)
#
# Game protocol ports (auth 3724, world 8085) are always published on all interfaces regardless.
# Set STACK_PUBLISH_BIND=127.0.0.1 to keep armory/client HTTP loopback-only on every local stack.
# On a Linux host where this manager runs in a container, set STACK_DATAPLANE_BIND to the docker
# bridge gateway (e.g. 172.17.0.1) so the manager can reach MySQL/SOAP while they stay off the LAN.
STACK_PUBLISH_BIND=0.0.0.0
STACK_DATAPLANE_BIND=127.0.0.1

# Optional: explicit HS256 JWT signing key (>= 32 characters). When unset, the manager generates a
# random key on first startup and persists it in the data volume. Set this to share one key across
# multiple manager instances.
# AUTH_JWT_KEY=
