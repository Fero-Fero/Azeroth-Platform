{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/app/data/azeroth-platform.db"
  },
  "Admin": {
    // Single admin password gating the admin panel + admin API. Override via env: Admin__Password=...
    // Leave blank to have the server generate a random password at startup (logged to the console).
    "Password": ""
  },
  "Auth": {
    // Optional explicit HS256 JWT signing key (>= 32 chars). When blank, the server generates a random
    // 256-bit key and persists it to the data volume (decoupled from Admin:Password), so tokens survive
    // restarts. Set this to share one key across multiple manager instances. Override via env: Auth__JwtKey=...
    "JwtKey": "",
    "TokenLifetimeHours": 12
  },
  "Docker": {
    "SocketPath": "unix:///var/run/docker.sock",
    "BuildsPath": "/app/data/stacks",
    
    // Docker Compose command mode: "auto" (default), "plugin", or "standalone"
    // - "auto": Automatically detects available command (tries docker compose, then docker-compose)
    // - "plugin": Forces use of "docker compose" (Docker Compose V2 plugin)
    // - "standalone": Forces use of "docker-compose" (standalone binary)
    // Override via environment variable: Docker__ComposeCommand=plugin
    "ComposeCommand": "plugin"
  },
  "MySQL": {
    // Host to connect to for stack MySQL databases
    // Use "localhost" when running on host (default)
    // Use "host.docker.internal" when running in Docker container
    // Override via environment variable: MySQL__Host=host.docker.internal
    "Host": "localhost"
  },
  "SOAP": {
    // Host to connect to for stack SOAP endpoints
    // Use "localhost" when running on host (default)
    // Use "host.docker.internal" when running in Docker container
    // Override via environment variable: SOAP__Host=host.docker.internal
    "Host": "localhost"
  },
  "StackUpdateChecker": {
    "Enabled": true,
    "CheckIntervalMinutes": 60,
    "CheckOnStartup": true,
    "DelayStartupSeconds": 30
  },
  "GitHub": {
    "CriticalWorkflows": [
      "build-containers",
      "Build and Integration Test"
    ]
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:8080"]
  },
  "CloudOAuth": {
    // Admin SPA origin the OAuth callback redirects to (Vite in development; same-origin in production).
    "FrontendBaseUrl": "http://localhost:5173",
    "FrontendCallbackPath": "/admin/cloud/oauth-callback",
    // Public API base used as redirect_uri. Blank derives scheme+host from the incoming request.
    "PublicApiBaseUrl": "",
    "DigitalOcean": { "ClientId": "", "ClientSecret": "", "RedirectUri": "" },
    "Vultr": { "ClientId": "", "ClientSecret": "", "RedirectUri": "", "ProviderId": "", "AuthorizeUrl": "" },
    "Gcp": { "ClientId": "", "ClientSecret": "", "RedirectUri": "" },
    "Azure": { "ClientId": "", "ClientSecret": "", "RedirectUri": "", "TenantId": "" },
    "Aws": {
      // 12-digit account id that customer IAM roles must trust. Required for Connect AWS account.
      "PlatformAccountId": "",
      // Optional keys used only to call sts:AssumeRole. Blank uses the default AWS credential chain.
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "Region": "us-east-1"
    }
  },
  "Client": {
    // Root directory holding the distributable WoW client.
    // Layout: {RootPath}/game (client files), {RootPath}/settings (realmlist.wtf.tmpl, Config.wtf.tmpl),
    // {RootPath}/launcher.json (optional overrides).
    "RootPath": "/app/data/client",
    "GameExecutable": "Wow.exe",
    "LaunchArguments": "",
    "ClientVersion": "3.3.5a (12340)",
    "BrandingTitle": "Azeroth Platform Launcher",
    "Realmlist": {
      // Public address players' clients connect to (written into realmlist.wtf).
      "Host": "127.0.0.1",
      "Port": 3724
    },
    // File prefixes (relative to game/) that are always kept in sync and pruned when removed server-side.
    // "Interface/AddOns/" makes served addons auto-install, update, and uninstall on the launcher.
    "ManagedPrefixes": ["Data/patch-", "Interface/AddOns/"]
  },
  "Migrations": {
    // Docker image built from wdbx/Dockerfile, used to import CSV (.txt) into DBC files via Wine.
    "WdbxImage": "azerothcore-wdbx:mono",
    // Lightweight image built from mpqtool/Dockerfile, used to pack compiled DBCs into the client patch-D MPQ.
    "MpqToolImage": "azerothcore-mpqtool:latest",
    // File name of the generated client MPQ (matches the "Data/patch-" managed prefix so clients auto-update).
    "PatchDMpqName": "patch-D.MPQ",
    // Lightweight image used to read/write the stack data volume (dbc/maps).
    "VolumeToolImage": "alpine:3.20",
    // WoW client build number passed to WDBXEditor (3.3.5a = 12340).
    "WoWBuild": 12340,
    // Realmlist host advertised to launchers for per-stack client distribution.
    "RealmlistHost": "127.0.0.1",
    // Client settings templates (realmlist.wtf.tmpl, Config.wtf.tmpl) baked into the image and seeded
    // into each stack's client/settings/ on scaffold so the launcher always receives a realmlist.wtf.
    "ClientSettingsTemplatePath": "/app/client-example/settings"
  },
  "Launcher": {
    // .NET SDK image used to cross-publish the win-x64 single-file launcher in a docker sidecar.
    "SdkImage": "mcr.microsoft.com/dotnet/sdk:10.0",
    // Launcher source baked into the manager image (see Dockerfile "COPY launcher/").
    "SourcePath": "/app/launcher-src",
    // Writable copy of the source under the data volume (bind-mounted into the sidecar).
    "WorkPath": "/app/data/launcher-build",
    // Where the built launcher exe is stored for download.
    "DistPath": "/app/data/launcher-dist",
    "ProjectRelativePath": "AzerothPlatform.Launcher/AzerothPlatform.Launcher.csproj",
    "ExecutableName": "AzerothPlatformLauncher.exe"
  },
  "Armory": {
    // Shared image built once from the baked armory source and referenced by every stack.
    "ImageName": "azeroth-platform-armory:latest",
    // Armory source baked into the manager image (see Dockerfile "COPY frontend-armory/").
    "SourcePath": "/app/armory-src",
    // Host-visible working copy the image is built from.
    "WorkPath": "/app/data/armory-build",
    // Base URL the armory container uses for server-side calls to the platform (news).
    "PlatformApiUrl": "http://host.docker.internal:8080",
    // Public platform URL for browser-facing links (launcher download); blank falls back to PlatformApiUrl.
    "PublicUrl": ""
  },
  "ArmoryAssets": {
    // Persistent, writable root for operator-uploaded armory asset bundles (model-viewer dataset +
    // static web assets). Lives on the data volume so uploads survive restarts and take precedence
    // over assets baked into the manager image.
    "RootPath": "/app/data/armory-assets"
  },
  "ClientServer": {
    // Shared self-contained WoW client file server image, one container per stack. Serves its own
    // SHA-256 manifest + files from a shared base volume (ro) + per-stack overlay volume (rw).
    "ImageName": "azeroth-platform-client:latest",
    // Backend source baked into the manager image (see Dockerfile "COPY backend/") used to build it.
    "SourcePath": "/app/backend-src",
    // Host-visible working copy the image is built from.
    "WorkPath": "/app/data/client-server-build",
    // Dockerfile path relative to the build context (the ClientServer project folder).
    "DockerfileRelativePath": "AzerothPlatform.ClientServer/Dockerfile",
    // Port the client-server listens on inside the container.
    "ContainerPort": 8090
  }
}
