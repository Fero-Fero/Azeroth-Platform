<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzerothPlatform.Core\AzerothPlatform.Core.csproj" />
    <ProjectReference Include="..\AzerothPlatform.ClientManifest\AzerothPlatform.ClientManifest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Account login is verified in-container against the stack's own auth MySQL DB (so login works on
         a VPC with no manager present). -->
    <PackageReference Include="Dapper" Version="2.1.44" />
    <PackageReference Include="MySql.Data" Version="9.2.0" />
  </ItemGroup>

</Project>
